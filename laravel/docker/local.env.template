APP_NAME="Auction Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=auction_marketplace
DB_USERNAME=auction
DB_PASSWORD=auction
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@auction.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=auction-media
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/auction-media
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local-meilisearch-key-change-before-production
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
FORWARD_MEILISEARCH_PORT=7700

REVERB_APP_ID=auction-marketplace-local
REVERB_APP_KEY=auction-marketplace-local-key
REVERB_APP_SECRET=auction-marketplace-local-secret-change-before-production
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

HORIZON_PREFIX=auction_horizon:
LOCAL_UID=1000
LOCAL_GID=1000

