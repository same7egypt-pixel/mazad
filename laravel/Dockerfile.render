FROM php:8.3-cli-bookworm AS vendor

WORKDIR /var/www

RUN apt-get update \
    && apt-get install -y --no-install-recommends libicu-dev libzip-dev \
    && docker-php-ext-install -j"$(nproc)" intl pcntl zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-plugins --prefer-dist --optimize-autoloader --no-scripts

FROM node:22-bookworm-slim AS frontend

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.js ./
COPY --from=vendor /var/www/vendor ./vendor
COPY app/Filament ./app/Filament
COPY resources ./resources
COPY public ./public
RUN npm run build

FROM postgres:18-bookworm AS postgres-client

FROM php:8.3-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gettext-base \
        libicu-dev \
        libpq-dev \
        libzip-dev \
        nginx \
        unzip \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        intl \
        opcache \
        pcntl \
        pdo_pgsql \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

WORKDIR /var/www
COPY --from=vendor /usr/bin/composer /usr/bin/composer
COPY --from=postgres-client /usr/lib/postgresql/18/bin/pg_dump /usr/local/bin/pg_dump
COPY --from=postgres-client /usr/lib/postgresql/18/bin/pg_restore /usr/local/bin/pg_restore
COPY --from=postgres-client /usr/lib/postgresql/18/bin/psql /usr/local/bin/psql
COPY --from=postgres-client /usr/lib/x86_64-linux-gnu/libpq.so.5 /usr/local/lib/libpq.so.5
COPY --from=postgres-client /usr/lib/x86_64-linux-gnu/libpq.so.5.18 /usr/local/lib/libpq.so.5.18
COPY . .
COPY --from=vendor /var/www/vendor ./vendor
COPY --from=frontend /build/public/build ./public/build
COPY docker/php/php.ini /usr/local/etc/php/conf.d/99-auction-marketplace.ini
COPY docker/render/nginx.conf.template /etc/nginx/templates/auction.conf.template
COPY --chmod=755 docker/render/entrypoint.sh /usr/local/bin/render-entrypoint
COPY --chmod=755 docker/render/start-web.sh /usr/local/bin/render-web
COPY --chmod=755 docker/render/start-trial-web.sh /usr/local/bin/render-trial-web
COPY --chmod=755 docker/render/migrate-to-neon.sh /usr/local/bin/migrate-to-neon

RUN composer dump-autoload --no-dev --classmap-authoritative --no-scripts \
    && php artisan package:discover --ansi \
    && php artisan filament:upgrade

RUN printf '%s\n' /usr/local/lib > /etc/ld.so.conf.d/postgres18-client.conf \
    && ldconfig

RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache /var/lib/nginx /var/log/nginx /run

ENTRYPOINT ["render-entrypoint"]
CMD ["render-web"]
