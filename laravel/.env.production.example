APP_NAME="Auction Marketplace"
APP_ENV=production
APP_KEY=base64:replace_with_php_artisan_key_generate_show_output
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@host:5432/auction_marketplace
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=internal-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=null
HORIZON_PREFIX=auction_horizon:

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=auction-meilisearch:7700
MEILI_MASTER_KEY=replace_with_shared_meilisearch_secret

REVERB_APP_ID=replace_with_shared_reverb_id
REVERB_APP_KEY=replace_with_shared_reverb_key
REVERB_APP_SECRET=replace_with_shared_reverb_secret
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

AWS_ACCESS_KEY_ID=replace_with_s3_access_key
AWS_SECRET_ACCESS_KEY=replace_with_s3_secret
AWS_DEFAULT_REGION=replace_with_s3_region
AWS_BUCKET=replace_with_private_media_bucket
AWS_URL=https://private-media-bucket.example.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Auction Marketplace"
